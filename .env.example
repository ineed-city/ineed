# Copiază acest fișier în .env.local și completează valorile reale.
# .env.local NU se pune niciodată în Git (repo-ul e public).

# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# SECRETE: doar pe server, fără prefixul NEXT_PUBLIC_. În Vercel, tip „Secret”.
# Supabase → Project Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
# Codul de invitație cerut la „Creează cont”. Alege unul lung, greu de ghicit.
SIGNUP_CODE=alege-un-cod-lung

# Existing Claude API key, server-only. Never paste a key into source or chat.
ANTHROPIC_API_KEY=
# Optional override of the default answer model.
CONCIERGE_MODEL=claude-haiku-5-5

# Google Places API (New), restricted server-only key. Never NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=
